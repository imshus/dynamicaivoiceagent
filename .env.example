# ── API keys ─────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ── The voice (one, fixed) ───────────────────────────────────────────────────
ELEVENLABS_VOICE_ID=H6QPv2pQZDcGqLwDTIJQ   # "Kanika - Soft, Smooth and Muffled" (professional, hi-IN), the owner's choice. On flash it measured 3.8-4.2 semitones of pitch wander; eleven_turbo_v2_5 is its tuned model (2.3)
AGENT_NAME=Kanika
GREETING=Hello, this is {name}. How can I help you today?

# ── Speech to text (Deepgram Flux) ───────────────────────────────────────────
DEEPGRAM_MODEL=flux-general-multi
FLUX_EOT_THRESHOLD=0.7          # end-of-turn confidence gate 0.5–0.9 (higher = waits longer)
FLUX_EAGER_EOT_THRESHOLD=0.5    # start drafting the reply early at this confidence
FLUX_EOT_TIMEOUT_MS=5000
FLUX_LANGUAGE_HINTS=hi,en
# The words this helpline turns on, so Flux stops hearing "cash tone" for "colorstone".
# A question the model never received intact cannot be answered — fix hearing first.
DEEPGRAM_KEYTERMS=MRPscan,MRP,bullion,MCX,RTGS,cash rate,karat,purity,tunch,gold rate,making charges,labour charge,wastage,gross weight,net weight,diamond,packet code,sieve,clarity,colorstone,stone rate,item code,masters,dashboard settings,scanner,tag,e-invoice,GST,wishlist,employee manager,set permission,dashboard matrices,active account,password manager

# ── The brain (OpenAI GPT-6 Luna) ──────────────────────────────────────────
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low     # none | low | medium — low: a moment's thought to pick the right note, hidden behind the eager draft
LLM_MAX_TOKENS=300
MAX_HISTORY_TURNS=20
SPECULATIVE_LLM=true            # draft on EagerEndOfTurn, confirm on EndOfTurn
# Walking a caller through the app: after asking "are you there?", check in if
# nothing comes back — a caller doing the step is quiet, not gone. Then stop asking.
NUDGE_AFTER_SECONDS=12          # 0 = never check in
NUDGE_MAX=2                     # how many times, before leaving the line alone
PROMPT_FILE=prompt.md           # the persona; edits apply on the next call
KNOWLEDGE_FILE=faq.md           # what the agent knows (the MRPscan FAQ, en+hi); leave empty for none
# OPENAI_BASE_URL=              # Azure / any OpenAI-compatible host

# ── Text to speech (ElevenLabs) ──────────────────────────────────────────────
# ONE stream for the whole call: greeting and every reply are a single continuous
# generation, so tone, pace and loudness cannot reset between them.
ELEVENLABS_MODEL=eleven_flash_v2_5  # fastest (first audio ~200 ms); the owner's choice over turbo
OUTPUT_SAMPLE_RATE=24000        # 16000 | 22050 | 24000
ELEVENLABS_STABILITY=1.0        # 1.0 = one steady pitch and loudness (lower = expressive, wanders)
ELEVENLABS_SIMILARITY=0.85
ELEVENLABS_STYLE=0.0            # keep 0 — anything else moves the level around
ELEVENLABS_SPEAKER_BOOST=false  # keep off — it re-levels each piece
TTS_SPEED=1.05                  # fixed for the whole call; 1.0 was heard as too slow (owner's choice, 3 Oct 2026)
TTS_FLUSH_EVERY_SENTENCE=true   # true = each sentence starts generating at once (fast first audio);
                                # false = bigger pieces paced by ElevenLabs' schedule, a little more wait

# ── Turn-taking ──────────────────────────────────────────────────────────────
BARGE_IN_ENABLED=true
BARGE_IN_MIN_CHARS=2
BARGE_IN_ECHO_OVERLAP=0.6       # share of caller words matching the agent's own speech → treated as echo

# ── Server ───────────────────────────────────────────────────────────────────
HTTP_PORT=8100
PRATHAM_AI_URL=https://prathamai.mrpscan.com   # public URL of the deployed agent; socket = wss://prathamai.mrpscan.com/ws
